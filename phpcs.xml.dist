<?xml version="1.0"?>
<ruleset name="RCS HRMS">
    <description>PHPCS config for RCS HRMS — PSR-12 with legacy relaxations</description>

    <!-- Only scan PHP files in these dirs -->
    <file>php_payroll/</file>
    <file>api/</file>

    <!-- Exclude vendor, uploads, generated -->
    <exclude-pattern>php_payroll/vendor/</exclude-pattern>
    <exclude-pattern>php_payroll/uploads/</exclude-pattern>
    <exclude-pattern>php_payroll/tmp_sessions/</exclude-pattern>
    <exclude-pattern>php_payroll/config/config.local.php</exclude-pattern>

    <!-- PSR-12 base standard -->
    <rule ref="PSR12">
        <!-- Legacy code relaxations -->
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
        <exclude name="PSR12.Properties.ConstantVisibility"/>

        <!-- Allow short echo tags (legacy views use <?=) -->
        <exclude name="Generic.PHP.DisallowShortOpenTag.EchoFound"/>

        <!-- Allow mixed line endings (some files have CRLF) -->
        <exclude name="Generic.Files.LineEndings.InvalidEOLChar"/>
    </rule>

    <!-- Catch common bugs -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="mysql_query"/>
                <element key="mysql_fetch_assoc"/>
                <element key="mysql_connect"/>
                <element key="mysql_real_escape_string"/>
                <element key="eval"/>
                <element key="extract"/>
                <element key="var_dump"/>
            </property>
        </properties>
    </rule>

    <!-- Line length — generous for SQL queries in PHP -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="180"/>
            <property name="absoluteLineLimit" value="250"/>
        </properties>
    </rule>
</ruleset>
