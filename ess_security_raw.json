    "html": "<html><head><meta name=\"color-scheme\" content=\"light dark\"></head><body><pre style=\"word-wrap: break-word; white-space: pre-wrap;\"><?php\n/**\n * RCS ESS - Centralized Security Headers\n * Include AFTER cors.php in every API endpoint.\n */\nif (!headers_sent()) {\n    header('X-Frame-Options: DENY');\n    header('X-Content-Type-Options: nosniff');\n    header('X-XSS-Protection: 1; mode=block');\n    header('Referrer-Policy: strict-origin-when-cross-origin');\n    header('Permissions-Policy: camera=(), microphone=(), geolocation=()');\n    header('Strict-Transport-Security: max-age=31536000; includeSubDomains');\n}\n</pre></body></html>",
