parameters:
    # Level 0 = only critical errors (undefined classes, syntax errors)
    # Legacy HRMS code wasn't written for static analysis — level 4 is too strict
    level: 0
    paths:
        - api
        - hrms
    bootstrapFiles:
        - phpstan-bootstrap.php
    # Common legacy patterns that are safe to ignore at level 0+
    ignoreErrors:
        - '#Variable \$db might not be defined#'
        - '#Variable \$conn might not be defined#'
        - '#Variable \$stmt might not be defined#'
        - '#Variable \$result might not be defined#'
        - '#Variable \$row might not be defined#'
        - '#Offset .+ on .+ on left side of \?\? always exists#'
    # Skip test/temp files
    excludePaths:
        - '*/vendor/*'
        - '*/node_modules/*'
        - '*/cache/*'
        - '*/temp/*'
