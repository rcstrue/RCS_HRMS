# PHPStan configuration for the RCS HRMS PHP application.
# Reference: https://phpstan.org/config-reference
#
# Applied by .github/workflows/php-lint.yml. Level 4 is analysed across the whole
# app; the findings that already existed when this config was introduced are
# frozen in phpstan-baseline.neon, so the job is green now and a red build means
# *new* level-4 problems.
#
# Regenerate the baseline after intentionally fixing baselined code:
#   phpstan analyse --configuration=phpstan.neon --generate-baseline
# (this repo has no composer.json, so install PHPStan however you prefer — e.g.
#  `composer require --dev phpstan/phpstan` in a scratch dir, or the phar from
#  github.com/phpstan/phpstan/releases — the CI pins 2.2.17, matching this baseline)
parameters:
    level: 4
    paths:
        - hrms
        - api
    excludePaths:
        # runtime/generated data, not source
        - hrms/logs/*
        - hrms/tmp_sessions/*
        - hrms/uploads/*
    # Do not fail when a baselined error disappears (e.g. someone fixed it and
    # forgot to regenerate) — that would punish improvements.
    reportUnmatchedIgnoredErrors: false

includes:
    - phpstan-baseline.neon
