<?xml version="1.0"?>
<ruleset name="RCS_HRMS">
    <description>PHP CodeSniffer rules for RCS HRMS</description>

    <!-- Use PSR-12 as the base standard -->
    <rule ref="PSR12"/>

    <!-- Only scan PHP files in these directories -->
    <file>api</file>
    <file>hrms</file>

    <!-- Exclude vendor and cache dirs -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>

    <!-- Allow long lines in API files (JSON payloads) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="200"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
