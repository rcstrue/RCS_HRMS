<?xml version="1.0"?>
<ruleset name="RCS_HRMS">
    <description>PHP CodeSniffer rules for RCS HRMS (permissive for legacy code)</description>

    <!-- Only scan PHP files in these directories -->
    <file>api</file>
    <file>hrms</file>

    <!-- Exclude vendor and cache dirs -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>

    <!-- Minimal critical-only rules for legacy code -->
    <!-- Note: short opening tags <?= are valid in PHP 5.4+ and standard in templates -->
    <rule ref="Squiz.PHP.Eval"/>
    <rule ref="Squiz.PHP.DiscouragedFunctions"/>

    <!-- Allow long lines -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="500"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
