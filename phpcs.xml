<?xml version="1.0"?>
<ruleset name="RCS_HRMS">
    <description>PHP CodeSniffer rules for RCS HRMS (permissive for legacy code)</description>

    <!-- Only scan PHP files in these directories -->
    <file>api</file>
    <file>hrms</file>

    <!-- Exclude vendor and cache dirs -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>

    <!-- Use a minimal rule set — legacy code wasn't written to PSR-12 standards -->
    <!-- Only check for critical errors, not style -->
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.PHP.DisallowMultipleStatementsPerLine"/>
    <rule ref="Squiz.PHP.Eval"/>
    <rule ref="Squiz.PHP.DiscouragedFunctions"/>

    <!-- Allow long lines -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="500"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
