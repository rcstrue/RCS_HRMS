# ═══════════════════════════════════════════════════════════════════════════
#  RCS HRMS — Centralized Environment Configuration
#
#  This is the SINGLE source of truth for ALL credentials.
#  Copy to /home/rcsfaxhz/.env and fill in real values.
#  NEVER commit the real .env file to git.
#
#  Setup (on the server):
#    cp .env.example /home/rcsfaxhz/.env
#    nano /home/rcsfaxhz/.env     # fill in real values
#    chmod 600 /home/rcsfaxhz/.env
#    chown rcsfaxhz:rcsfaxhz /home/rcsfaxhz/.env
#
#  Location: /home/rcsfaxhz/.env (OUTSIDE public_html — not web-accessible)
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ── HRMS Application ──────────────────────────────────────────────────────
# 32-character random string used for encrypting sensitive PII at rest.
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=your_32_char_encryption_key_here

# ── ESS API ──────────────────────────────────────────────────────────────
# API key for the ESS mobile app backend (sent as X-API-KEY header).
# Generate with: openssl rand -hex 32
ESS_API_KEY=your_ess_api_key_here

# JWT signing secret for ESS authentication tokens.
# Generate with: openssl rand -hex 32
ESS_JWT_SECRET=your_jwt_secret_here

# JWT token expiry in seconds (default: 24 hours).
ESS_JWT_EXPIRY=86400

# ── WhatsApp Bot ──────────────────────────────────────────────────────────
# MUST match the `notif_wa_bot_key` value in the HRMS `settings` DB table.
# Generate with: openssl rand -hex 32
WA_API_KEY=your_whatsapp_bot_key_here

# Port the bot's HTTP API listens on (internal only).
WA_PORT=3001

# Directory where Baileys stores WhatsApp session credentials.
WA_SESSION_DIR=/home/rcsfaxhz/auth_info_baileys

# ── SMTP Email ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# From address for outgoing HRMS emails.
SMTP_FROM=noreply@rcsfacility.com
SMTP_FROM_NAME=RCS HRMS Pro

# ── HRMS Base URL (for WhatsApp bot callbacks) ──────────────────────────
# Full URL to the HRMS root, without trailing slash.
HRMS_BASE_URL=https://join.rcsfacility.com/hrms

# ── Optional: VAPID keys for Web Push ────────────────────────────────────
# These are normally generated and stored in the DB `settings` table
# via the HRMS admin UI. If you prefer to set them via .env, uncomment:
# PUSH_VAPID_PUBLIC_KEY=your_vapid_public_key
# PUSH_VAPID_PRIVATE_KEY=your_vapid_private_key
# PUSH_VAPID_SUBJECT=mailto:hr@rcsfacility.com
