# ═══════════════════════════════════════════════════════════════════════════
#  RCS HRMS — WhatsApp Bot Environment Configuration Template
#
#  Copy this file to .env on the server and fill in the real values.
#  The .env file must NEVER be committed to git (it's in .gitignore).
#
#  Setup (on the server):
#    cp .env.example /home/rcsfaxhz/.env
#    nano /home/rcsfaxhz/.env   # fill in real values
#    pm2 restart whatsapp-bot --update-env
# ═══════════════════════════════════════════════════════════════════════════

# WhatsApp Bot API key — MUST match the `notif_wa_bot_key` value in the
# HRMS `settings` DB table. Generate a new random key when setting up.
# Example format: a 32+ character alphanumeric string.
# NEVER use the old hardcoded value — it was exposed in git history.
WA_API_KEY=GENERATE_A_NEW_RANDOM_KEY_HERE

# Port the bot's HTTP API listens on (internal only, behind the firewall).
WA_PORT=3001

# Directory where Baileys stores the WhatsApp session credentials.
# This directory must NOT be web-accessible.
WA_SESSION_DIR=/home/rcsfaxhz/auth_info_baileys

# HRMS base URL (used for delivery callbacks + queue API calls).
# Must be the full URL to the HRMS root, without trailing slash.
HRMS_BASE_URL=https://join.rcsfacility.com/hrms

# Optional: override the callback/queue URLs if they differ from the
# default pattern (HRMS_BASE_URL + /wa-delivery-callback.php, /wa-queue.php).
# Leave commented to use the defaults.
# HRMS_CALLBACK_URL=https://join.rcsfacility.com/hrms/wa-delivery-callback.php
# HRMS_QUEUE_URL=https://join.rcsfacility.com/hrms/wa-queue.php
