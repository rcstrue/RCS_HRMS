RewriteEngine On

# ── Custom 404 handler for unknown paths ──
ErrorDocument 404 /404.html

# ── Security: Block direct access to sensitive files ──
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block direct access to config, includes, and templates ──
RewriteRule ^config/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^templates/ - [F,L]
